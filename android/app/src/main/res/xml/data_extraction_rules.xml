<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- ORVIKA does not use Android-managed cloud backup or restore. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <!-- Exclude app data from device-to-device transfer as well. -->
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
